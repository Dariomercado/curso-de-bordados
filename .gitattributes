# Normalize line endings: LF in the working tree and in the repository.
* text=auto eol=lf

# Explicit text types
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary assets (never touched by EOL conversion)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary

# Keep shell scripts LF even on Windows checkouts
*.sh    text eol=lf
